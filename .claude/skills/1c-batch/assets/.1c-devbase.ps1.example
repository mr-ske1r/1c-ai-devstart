# ============================================================
# Настройки подключения к базе 1С (PowerShell-вариант).
#
# Скопируйте этот файл в корень репозитория как .1c-devbase.ps1
# и заполните актуальными значениями.
#
# ВАЖНО:
#   * Не коммитьте .1c-devbase.ps1 в репозиторий!
#   * Сохраняйте .1c-devbase.ps1 в кодировке UTF-8 С BOM
#     (Windows PowerShell 5.1 читает .ps1 без BOM как ANSI и портит кириллицу).
#
# Укажите ЛИБО серверную базу ($ONEC_SERVER + $ONEC_BASE),
# ЛИБО файловую базу ($ONEC_FILEBASE_PATH).
# Приоритет: серверная база (если $ONEC_SERVER задан).
# ============================================================

$ONEC_PATH = "C:\Program Files\1cv8\8.3.24.1467\bin\1cv8.exe"

# === Серверная база (приоритет) ===
$ONEC_SERVER = "server-1c"
$ONEC_BASE   = "erp_dev"

# === Файловая база (если серверная не указана) ===
# $ONEC_FILEBASE_PATH = "D:\Bases\MyBase"

# === Авторизация ===
$ONEC_USER     = "Администратор"
$ONEC_PASSWORD = ""
